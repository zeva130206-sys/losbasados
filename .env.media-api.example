FIREBASE_API_KEY=the-public-firebase-web-api-key
# Mission API only: server-side service-account credentials; never expose these in the frontend.
FIREBASE_SERVICE_ACCOUNT_EMAIL=media-api@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key-content\n-----END PRIVATE KEY-----\n"
GITHUB_TOKEN=server-side-fine-grained-token-with-contents-write
GITHUB_OWNER=your-github-owner
GITHUB_REPO=your-pages-repository
GITHUB_BRANCH=main
PUBLIC_SITE_URL=https://your-owner.github.io/your-repository
MODERATOR_EMAILS=moderator@example.com
ALLOWED_ORIGINS=https://your-owner.github.io
PORT=8787
